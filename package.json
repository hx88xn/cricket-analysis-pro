{
  "name": "cricket-analysis-pro",
  "version": "1.0.0",
  "description": "Cricket scoring and analysis desktop UI",
  "author": "Cricket Analysis Pro",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cricketanalysis.pro",
    "productName": "Cricket Analysis Pro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*"
    ],
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSCameraUsageDescription": "Record match video for cricket analysis.",
        "NSMicrophoneUsageDescription": "Record audio with match video when available."
      }
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Cricket Analysis Pro"
    },
    "linux": {
      "target": ["deb", "tar.gz"],
      "category": "Utility",
      "maintainer": "Cricket Analysis Pro <noreply@local>"
    }
  }
}
