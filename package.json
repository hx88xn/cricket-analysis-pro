{
  "name": "cricket-analysis-pro",
  "version": "1.0.0",
  "description": "Cricket scoring and analysis desktop UI",
  "author": "CRICPRO",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist:win": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.cricketanalysis.pro",
    "productName": "CRICPRO",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "src/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "extendInfo": {
        "NSCameraUsageDescription": "Record match video for cricket analysis.",
        "NSMicrophoneUsageDescription": "Record audio with match video when available."
      }
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CRICPRO"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "deb",
        "tar.gz"
      ],
      "category": "Utility",
      "maintainer": "CRICPRO <noreply@local>"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
